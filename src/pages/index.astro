---
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/source-sans-3/latin-300.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-500.css';
import '../styles/immersive.css';
import { BEATS, LAST } from '../lib/immersive';
import { SOURCES } from '../lib/chapters';
const acts = [...new Set(BEATS.map(b => b.act))];
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#061e24" />
  <title>Techne — Another web is possible</title>
  <meta name="description" content="An immersive journey from a captured internet to a living web. A story about the tools we shape, and the worlds they make possible." />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='16' fill='%23061e24'/%3E%3Cpath d='M16 6v20M6 16h20M9 9l14 14M9 23L23 9' stroke='%23b5f5d2' stroke-width='1.4'/%3E%3C/svg%3E" />
  <link rel="preload" as="image" href={`${base}art/immersive/valley.webp`} />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <a class="skip-link" href="#connection">Skip to the story</a>
  <div class="world" aria-hidden="true">
    <img class="world-fallback" src={`${base}art/immersive/valley.webp`} alt="" fetchpriority="high" />
    <canvas id="world" data-base={base}></canvas>
    <div class="readability"></div>
    <div class="hero-shade"></div>
    <div class="edge-shade"></div>
  </div>
  <header class="film-header">
    <a class="wordmark" href="#connection" aria-label="Techne, return to the beginning">techne</a>
    <button id="chapters-open" class="quiet-control" aria-haspopup="dialog"><span>Explore</span><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h9" stroke="currentColor" fill="none" stroke-width="1.2"/></svg></button>
  </header>
  <main id="story" aria-label="Another web is possible: an illustrated story">
    {BEATS.map((beat, i) => (
      <section id={beat.id} class:list={['beat', { 'opening': i === 0, 'ending': i === LAST }]} data-beat={i} aria-labelledby={`${i === 0 ? 'title' : 'heading'}-${beat.id}`}>
        <div class="copy">
          {i > 0 && <p class="act-label">{beat.act}<span>{String(i + 1).padStart(2, '0')} / {BEATS.length}</span></p>}
          <>{i === 0 && <h1 id={`title-${beat.id}`}>{beat.title.split('\n').map((line) => <span>{line}</span>)}</h1>}</>
          {i !== 0 && <h2 id={`heading-${beat.id}`}>{beat.title.split('\n').map((line) => <span>{line}</span>)}</h2>}
          <p class="narration">{beat.body}</p>
          {beat.action && <div class="exchange"><button class="exchange-button" data-exchange={i}><span class="spark-icon" aria-hidden="true">✳</span>{beat.action}<svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" fill="none" stroke-width="1.2"/></svg></button><p class="exchange-result" role="status" aria-live="polite"></p></div>}
          {i > 0 && i < LAST && <button class="chapter-note-button" data-note={i} aria-haspopup="dialog">Look closer <span aria-hidden="true">＋</span></button>}
          {i === LAST && <div class="end-actions"><a href="mailto:synergy@benjaminlife.one?subject=Funding%20the%20Techne%20SDK" class="primary-link">Fund the living web <span aria-hidden="true">↗</span></a><a href="https://unforcedagi.github.io/techne-www/writing/protocols-of-belonging/" class="contact-link">Explore the thinking</a></div>}
        </div>
      </section>
    ))}
  </main>
  <footer class="film-footer">
    <button id="chapter-label" class="chapter-label" aria-label="Open chapters">Connection</button>
    <a id="continue" class="continue" href="#packets"><span>Scroll to discover</span><span class="scroll-stem" aria-hidden="true"></span></a>
    <button id="motion" class="quiet-control motion-control" aria-pressed="false" aria-label="Reduce motion"><svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M7 5v10M13 5v10" stroke="currentColor" stroke-width="1.5" /></svg><span>Quiet motion</span></button>
  </footer>
  <div class="progress-track" aria-hidden="true"><div id="progress-fill"></div></div>
  <dialog id="guide" aria-labelledby="guide-title">
    <div class="guide-top"><p class="wordmark" id="guide-title">A living web</p><button id="chapters-close" class="close-control" aria-label="Close exploration menu">×</button></div>
    <p class="guide-intro">One world. A different way to connect.</p>
    <nav aria-label="Story chapters">{acts.map(act => <div class="act-group"><h2>{act}</h2><ol>{BEATS.map((b,i) => b.act === act && <li><a href={`#${b.id}`}><span class="chapter-number">{String(i+1).padStart(2,'0')}</span><span>{b.chapter}</span><span aria-hidden="true">↗</span></a></li>)}</ol></div>)}</nav>
    <button id="read-mode" class="text-control">Read as a simple story</button>
    <details><summary>About the story & sources</summary><p>A visual argument for tools that serve living relationships. The towers and eye are metaphors for concentrated power and accelerating incentives. The eye gives form to Moloch: the competitive pressure to keep capturing more. The communities imagine a possibility; open protocols alone cannot guarantee it.</p><p>The abstract corporate marks are invented. The terrain and architecture use AI-generated artwork; lighting, camera motion, networks and exchanges respond to your scroll.</p><ul>{Object.values(SOURCES).map(s => <li><a href={s.url}>{s.title}</a></li>)}</ul><p>AT Protocol is a federation of servers. “Peer to peer” here describes relationships between people and communities. Portability depends on control of identity and access to your data.</p><p><a href={`${base}story.md`} download="techne-story.md">Download the story</a>. No analytics or tracking.</p></details>
  </dialog>
  <dialog id="chapter-note" aria-labelledby="note-title">
    <div class="guide-top"><p class="act-label" id="note-act"></p><button id="note-close" class="close-control" aria-label="Close chapter note">×</button></div>
    <h2 id="note-title"></h2><p id="note-mechanism"></p><p id="note-body"></p>
    <ul id="note-sources"></ul><p class="note-foot">The animated landscape is a visual metaphor. Sources distinguish documented mechanisms from the story’s proposals.</p>
  </dialog>
  <noscript><div class="nojs-end"><p>This is the complete story. Enable JavaScript to explore the animated landscape.</p><a href="https://unforcedagi.github.io/techne-www/writing/protocols-of-belonging/">Explore Techne’s writing</a></div></noscript>
  <script>import '../scripts/immersive';</script>
</body>
</html>

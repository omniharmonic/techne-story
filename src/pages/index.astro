---
import '@fontsource/newsreader/latin-400.css';
import '@fontsource/newsreader/latin-400-italic.css';
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-500.css';
import '../styles/global.css';
import Demo from '../components/Demo.astro';
import { parseStory } from '../lib/story.ts';
import { CAPTIONS, LONG_TITLES } from '../lib/sceneMeta.ts';
import { STILL_VIEW, stillInput, worldMarkup } from '../lib/world/render.ts';

const base = import.meta.env.BASE_URL;
const { scenes } = parseStory();
const world = worldMarkup(stillInput(0));
const v = STILL_VIEW;
const acts = [
  { href: '#open', label: 'Open', n: 1 },
  { href: '#captured', label: 'Captured', n: 2 },
  { href: '#freed', label: 'Freed', n: 3 },
  { href: '#alive', label: 'Alive', n: 4 },
];
---
<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='7' fill='%2310272d'/%3E%3Ccircle cx='16' cy='16' r='5' fill='%23e7ae74'/%3E%3Ccircle cx='16' cy='16' r='9' fill='none' stroke='%23e7ae74' stroke-width='1.6'/%3E%3C/svg%3E" />
    <title>Techne — A living web</title>
    <meta name="description" content="How the internet was captured, how the middle can be taken back out, and what a network shaped like a living system could serve." />
    <script is:inline>
      (function () {
        var c = document.documentElement.classList;
        c.remove('no-js');
        c.add('js');
        c.add('film-live');
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) c.add('reduce');
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#story">Skip to the story</a>

    <header class="site-header" id="top">
      <div class="bar">
        <h1 class="wordmark"><a href="#open">techne</a></h1>
        <button type="button" class="options-btn" id="optionsBtn" aria-expanded="false" aria-controls="options">
          Reading options
          <svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1 1.5 L6 6.5 L11 1.5" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
        </button>
      </div>
      <div class="options" id="options" hidden>
        <button type="button" class="toggle" id="optStory" aria-pressed="false"><span class="check" aria-hidden="true"></span>Just the story</button>
        <button type="button" class="toggle" id="optHood" aria-pressed="false"><span class="check" aria-hidden="true"></span>Under the hood</button>
        <button type="button" class="toggle" id="optPause" aria-pressed="false"><span class="check" aria-hidden="true"></span>Pause motion</button>
        <button type="button" class="btn secondary small" id="optClose">Close</button>
      </div>
    </header>

    <nav class="acts" aria-label="Acts">
      <ol>
        {acts.map((a, i) => (
          <li>
            <a href={a.href} data-act={i} aria-current={i === 0 ? 'true' : undefined}>
              <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.3">
                {i === 0 && <g><path d="M5 7 L12 5 L19 8 L17 16 L8 18 L5 7 M12 5 L8 18 M19 8 L8 18 M5 7 L17 16"/><g fill="currentColor" stroke="none"><circle cx="5" cy="7" r="1.6"/><circle cx="12" cy="5" r="1.6"/><circle cx="19" cy="8" r="1.6"/><circle cx="17" cy="16" r="1.6"/><circle cx="8" cy="18" r="1.6"/></g></g>}
                {i === 1 && <g><path d="M12 12 L4 6 M12 12 L20 6 M12 12 L4 18 M12 12 L20 18 M12 12 L12 3 M12 12 L12 21"/><rect x="9" y="9" width="6" height="6" rx="1.5" fill="currentColor" stroke="none"/><g fill="currentColor" stroke="none"><circle cx="4" cy="6" r="1.4"/><circle cx="20" cy="6" r="1.4"/><circle cx="4" cy="18" r="1.4"/><circle cx="20" cy="18" r="1.4"/><circle cx="12" cy="3" r="1.4"/><circle cx="12" cy="21" r="1.4"/></g></g>}
                {i === 2 && <g><circle cx="7" cy="7" r="3.4"/><circle cx="17" cy="7" r="3.4"/><circle cx="7" cy="17" r="3.4"/><circle cx="17" cy="17" r="3.4"/><path d="M10.4 7 H13.6 M7 10.4 V13.6 M17 10.4 V13.6 M10.4 17 H13.6 M9.4 9.4 L14.6 14.6"/></g>}
                {i === 3 && <g><circle cx="7" cy="6" r="3"/><circle cx="17" cy="6" r="3"/><circle cx="7" cy="14" r="3"/><circle cx="17" cy="14" r="3"/><path d="M10 6 H14 M7 9 V11 M17 9 V11 M10 14 H14"/><path d="M2 21 Q7 18.5 12 20.5 T22 20"/></g>}
              </svg>
              <span><span class="act-n">{a.n} /</span> {a.label}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>

    <main id="story">
      <div class="film">
        <div class="stage" id="stage">
          <svg id="worldSvg" viewBox={`${v.x} ${v.y} ${v.w} ${v.h}`} preserveAspectRatio="xMidYMid slice" role="img" aria-labelledby="worldTitle worldDesc" focusable="false">
            <title id="worldTitle">One world that changes as you read</title>
            <desc id="worldDesc">{CAPTIONS.open}</desc>
            <Fragment set:html={world} />
          </svg>
          <div class="scrim" aria-hidden="true"></div>
          <p class="stage-caption" id="stageCaption" hidden>An imagined living landscape</p>
          <button type="button" class="expand" id="expandBtn" aria-pressed="false">Expand illustration</button>
        </div>

        <div class="narrative">
          <p class="no-js-note">This page is fully readable without JavaScript. Read the illustrated story below.</p>
          {scenes.map((s) => (
            <section class:list={['scene', { interlude: s.id === 'acceleration' }]} id={s.id} data-scene={s.index} aria-labelledby={`h-${s.id}`}>
              {s.firstOfAct && <p class="act-label">{s.act} / {s.actName}</p>}
              <h2 id={`h-${s.id}`} class:list={{ long: LONG_TITLES.has(s.id) }}>{s.title}</h2>
              <figure class="still">
                <img src={`${base}stills/${s.id}.svg`} alt="" width="1110" height="900" loading="lazy" decoding="async" />
                <figcaption>{CAPTIONS[s.id]}{s.index >= 10 ? ' An imagined possibility, not a place that exists today.' : ''}</figcaption>
              </figure>
              <div class="prose" set:html={s.body} />
              <Demo id={s.id} />
              {(s.hood || s.sources) && (
                <details class="deep">
                  <summary>Under the hood and sources</summary>
                  {s.hood && <div class="deep-part"><h3>Under the hood</h3><Fragment set:html={s.hood} /></div>}
                  {s.sources && <div class="deep-part"><h3>Sources</h3><Fragment set:html={s.sources} /></div>}
                </details>
              )}
            </section>
          ))}
        </div>
      </div>
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p><a href={`${base}story.md`} download="techne-story.md">Download the story</a> as Markdown. It is the same file this page is built from.</p>
        <p>No analytics or tracking scripts.</p>
        <details id="provenance">
          <summary>About this story and illustration</summary>
          <p>A Techne story developed from Benjamin Life’s project brief, assembled with Omni. The narrative explores how tools and networks might serve living relationships.</p>
          <p>The towers, lavender ribbon and shade over shared places are metaphors for incentives and concentrated power. The villages are imagined possibilities. The illustration is not evidence, data or a forecast.</p>
          <p>Terrain artwork was generated with AI and layered beneath a persistent, interactive SVG world. The story can be read without animation or JavaScript.</p>
        </details>
      </div>
    </footer>

    <p class="sr-only" id="announcer" role="status" aria-live="polite"></p>
    <script>
      import '../scripts/controller.ts';
    </script>
  </body>
</html>

---
import { PAIRS } from '../lib/sceneMeta.ts';
interface Props { name: string; always?: boolean }
const { name, always = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const pair = PAIRS[name];
---
<div class:list={['pair', { 'pair-always': always }]} data-pair={name}>
  {[pair.before, pair.after].map(([still, caption]) => (
    <figure>
      <img src={`${base}stills/${still}.svg`} alt="" width="1110" height="900" loading="lazy" decoding="async" />
      <figcaption>{caption}</figcaption>
    </figure>
  ))}
</div>
